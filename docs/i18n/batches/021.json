    {
      "key": "components.onboardingtourv3.0afabdd4308c",
      "source": "两条路就够：去搜索，去市场。",
      "kind": "text",
      "parameters": [],
      "locations": [
        {
          "file": "apps/desktop/src/components/OnboardingTourV3.tsx",
