{
  "name": "@onethu/desktop",
  "version": "0.8.0",
  "private": true,
  "description": "OneTHU 桌面端 —— Tauri 2 就绪的 React 界面",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "find src-tauri -name ._-\\* -delete; find src-tauri -name ._* ! -name . -delete; tauri",
    "tauri:dev": "find src-tauri -name ._-\\* -delete; find src-tauri -name ._* ! -name . -delete; tauri dev",
    "tauri:build": "find src-tauri -name ._-\\* -delete; find src-tauri -name ._* ! -name . -delete; tauri build",
    "build:harness": "node scripts/build-harness.mjs"
  },
  "dependencies": {
    "@onethu/core": "workspace:*",
    "@onethu/ui": "workspace:*",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-geolocation": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "leaflet": "^1.9.4",
    "mammoth": "^1.12.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-quill-new": "^3.8.3",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
