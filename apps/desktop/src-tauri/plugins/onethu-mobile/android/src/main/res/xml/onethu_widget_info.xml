<?xml version="1.0" encoding="utf-8"?>
<!--
  小组件元信息。

  - 初始占位 3 列 × 2 行（Android 12 起以 targetCell* 为准）；同一家族的方块 2×2 /
    窄条 2×1 / 长条 4×1 各有一份独立元信息（provider 数 = 选择器里可选的形态数）。
  - updatePeriodMillis=1800000：系统允许的最小刷新间隔（30 分钟）。真正的新鲜度靠
    App 前台刷新后主动 push 快照 + 点击打开 App 重算，不靠这里轮询。
  - widgetCategory=home_screen：仅桌面（不做锁屏小组件——锁屏下没有交互上下文）。
  - previewImage：部分国产启动器（ColorOS 等）不认 previewLayout，选择器里会显示空白
    甚至放置失败 → 同时提供静态 PNG 兜底（R21c 用户实录：ColorOS 上放上去桌面没有）。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:updatePeriodMillis="1800000"
    android:previewLayout="@layout/onethu_widget_preview_list"

    android:previewImage="@drawable/onethu_widget_preview"
    android:widgetFeatures="reconfigurable"
    android:initialLayout="@layout/onethu_widget"
    android:configure="app.onethu.mobile.OnethuWidgetConfigActivity"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/onethu_widget_desc" />
