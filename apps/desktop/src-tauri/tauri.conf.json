{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OneTHU",
  "version": "0.10.0",
  "identifier": "app.onethu.desktop",
  "build": {
    "beforeDevCommand": "node ./scripts/prebuild.mjs && pnpm dev",
    "devUrl": "http://127.0.0.1:5180",
    "beforeBuildCommand": "node ./scripts/prebuild.mjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OneTHU",
        "width": 1240,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/79.0.3945.88 Safari/537.36"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "resources": {
      "resources/plugins/": "plugins/"
    }
  }
}
