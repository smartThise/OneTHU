node_modules/
dist/
*.tsbuildinfo
.DS_Store
*.log
.env
.env.*
src-tauri/target/
src-tauri/gen/schemas/
apps/desktop/src-tauri/target/
packages/core/test/.venue-build/
packages/core/test/.caldav-build/

# sidecar 二进制按平台现场构建（仓库里绝不能带任何架构的二进制——Windows 打包曾把 mac 的 Mach-O 打进安装包）
apps/desktop/src-tauri/resources/plugins/onethu.harness/onethu-harness
apps/desktop/src-tauri/resources/plugins/onethu.harness/onethu-harness.exe

# tauri-plugin 构建脚本在插件 android 目录内生成的运行时拷贝（每次构建可再生）
apps/desktop/src-tauri/plugins/*/android/.tauri/
gradle/**

# Android gradle 缓存不入库（误提交 e52f355 教训）
.gradle/

# 本机 exFAT 规避配置（com.apple.provenance → ._* → tauri build.rs panic）——机器本地路径勿入库
**/.cargo/config.toml

# AppleDouble 资源叉（外接 exFAT 卷上写文件必生）：曾在 Android res 目录出现，
# 会被 aapt/manifest merger 当资源读进去报重复类——一律不入库
._*

# 工具目录里的 cargo 构建产物（tools/win-notify-check 等）：一次误提交曾把 628MB 带进历史
tools/*/target/

# 本机 AI 编码工具（Reasonix 等）在仓库根留下的会话状态：属于个人开发环境，
# 不该进版本库（历史上 0.1.0 那次误提交过一份）
.reasonix/
docs/BUILD-AGENT-GUIDE.md

# tauri-plugin 的 Gradle 构建中间产物落在插件 android 目录里（每次构建可再生；
# 一次本地构建就留下 1000+ 文件，含 .class 与打包资源）
apps/desktop/src-tauri/plugins/*/android/tmp/

# tauri android init 生成的安卓工程（每次构建可再生，含 gradle-wrapper.jar 与启动图标）。
# 仓库里曾跟踪一个指向 /Users/st/onethu-android 的符号链接——那是上游机器的绝对路径，
# 对其他机器本就是坏链，故移除跟踪项并整体忽略（与既有的 src-tauri/gen/schemas/ 同口径）。
#
# 末尾**不写 `/`**：gitignore(5) 里 `foo/` 只匹配真目录，"will not match a regular file
# or a symbolic link"。而 macOS 发布线恰是把这里做成指向内盘工程的**软链**
# （build-release-apk.sh 第③步）——若写成 `gen/android/`，软链形态会以未跟踪条目的
# 样子重新出现在 `git status` 里，一不小心又被 add 回来。不带斜杠则两种形态都忽略。
apps/desktop/src-tauri/gen/android

# 本机专用目录：编辑器调试配置（.vscode）与本机暂存/日志目录（.dsh-tmp）。
# 只留在本地，不入库（.vscode 里的调试配置因人而异，机器路径不可共享）
.vscode/
.dsh-tmp/

# Windows 本机构建脚本（dev-launch / android-dev / build-android 的 .mjs 实现）：只服务本机
# 的 Windows 工具链（%LOCALAPPDATA% 下的 SDK/JDK、.bat 经 cmd /c、符号链接权限自检），
# macOS/Linux 各有同名的 .sh 正路（dev-launch.sh / build-release-apk.sh）。故只留本地、不入库，
# 换机器按需自行携带；`.vscode/launch.json`（同样不入库）里调用的就是这里的 android-dev.mjs。
apps/desktop/scripts/dev-launch.mjs
apps/desktop/scripts/android-dev.mjs
apps/desktop/scripts/build-android.mjs
